              <stringProp name="parameters"></stringProp>
              <stringProp name="script">// Check if the login was successful
def isSuccess = prev.getResponseCode() == &apos;200&apos; // Assuming 200 indicates a successful login, adjust as needed

// If login was unsuccessful, store the username in a variable
if (!isSuccess) {
    def username = vars.get(&quot;${p_UserName}&quot;) // Assuming you have a variable named &quot;username&quot; containing the username used in the login request
    if (username != null) {
        // Define the file path
        def filePath = &quot;C://apache-jmeter-5.5//bin//unsuccessful_logins.csv&quot; // Change this to your desired file path
        
        // Save the username to a file
        def file = new File(filePath)
        file &lt;&lt; username + System.getProperty(&quot;line.separator&quot;) // Writing username to file with a newline
    }
}
</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
