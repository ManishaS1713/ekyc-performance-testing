              <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="BeanShell PostProcessor" enabled="true">
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <boolProp name="resetInterpreter">false</boolProp>
                <stringProp name="script">import org.apache.commons.io.FileUtils;

// Path to the file where responses will be saved
String filePath = &quot;C:/apache-jmeter-5.5/bin/Responses_Application_Organization_DGFT_VerifyLater_EsignNow.txt&quot;;

// Get the response data
String responseData = prev.getResponseDataAsString();

// Get the current serial number or initialize it if it&apos;s not set
String serialNumberString = vars.get(&quot;responseSerialNumber&quot;);
int serialNumber;
if (serialNumberString == null) {
    serialNumber = 1; // Start from 1 if the serial number is not set yet
} else {
    serialNumber = Integer.parseInt(serialNumberString);
}

// Assign the serial number to the response
String formattedResponse = &quot;[&quot; + serialNumber + &quot;] &quot; + responseData;

// Increment the serial number for the next response
serialNumber++;

// Update the serial number in JMeter variables
vars.put(&quot;responseSerialNumber&quot;, String.valueOf(serialNumber));

// Append the formatted response to the file with a newline character
try {
    FileUtils.writeStringToFile(new File(filePath), formattedResponse + &quot;\n&quot;, true);
} catch (IOException e) {
    log.error(&quot;Error writing to file: &quot; + e.getMessage());
}
</stringProp>
              </BeanShellPostProcessor>
