            <hashTree/>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import javax.crypto.Cipher
import javax.crypto.spec.SecretKeySpec
import javax.crypto.spec.IvParameterSpec
import org.apache.commons.codec.binary.Base64
import java.security.SecureRandom

// Decode the Base64 encoded key
def encodedKey = &quot;uWvMq6XECv2OyN24YMUjpl2mf7zo4a+GN0HIi05b4N4=&quot;
def keyBytes = Base64.decodeBase64(encodedKey)

// Ensure key length is correct
if (keyBytes.length != 32) {
    log.error(&quot;Invalid key length. Key must be exactly 32 bytes long for AES-256.&quot;)
    return
}

// Generate a random initialization vector (IV) - should be 16 bytes long
def iv = new byte[16]
new SecureRandom().nextBytes(iv)
def ivParameterSpec = new IvParameterSpec(iv)

def secretKeySpec = new SecretKeySpec(keyBytes, &quot;AES&quot;)

log.info(&quot;${p_UserName}&quot;);
log.info(&quot;${p_Password}&quot;);

// Get the username and password from parameters
def username = &quot;${p_UserName}&quot;
def password = &quot;${p_Password}&quot;

log.info(username);
log.info(password);

// Check if username and password are not null
if (username == null || password == null) {
    log.error(&quot;Username or password is null.&quot;)
    return
}

// Encrypt the username
def cipher = Cipher.getInstance(&quot;AES/CBC/PKCS5Padding&quot;)
cipher.init(Cipher.ENCRYPT_MODE, secretKeySpec, ivParameterSpec)
def encryptedUsernameBytes = cipher.doFinal(username.getBytes(&quot;UTF-8&quot;))
def encryptedUsername = Base64.encodeBase64String(encryptedUsernameBytes)

// Encrypt the password
cipher.init(Cipher.ENCRYPT_MODE, secretKeySpec, ivParameterSpec)
def encryptedPasswordBytes = cipher.doFinal(password.getBytes(&quot;UTF-8&quot;))
def encryptedPassword = Base64.encodeBase64String(encryptedPasswordBytes)

// Set the encrypted values back to variables
vars.put(&quot;encryptedUsername&quot;, encryptedUsername)
vars.put(&quot;encryptedPassword&quot;, encryptedPassword)


log.info(encryptedUsername);
log.info(encryptedPassword);
</stringProp>
            </JSR223PreProcessor>
