            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="false">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import org.apache.commons.codec.binary.Base64;


String username = &quot;${p_UserName}&quot;;
String password = &quot;${p_Password}&quot;;


String encodedUsername = Base64.encodeBase64String(username.getBytes());
String encodedPassword = Base64.encodeBase64String(password.getBytes());

vars.put(&quot;encodedUsername&quot;, encodedUsername);
vars.put(&quot;encodedPassword&quot;, encodedPassword);

log.info(&quot;Username is :&quot;+encodedUsername);
log.info(&quot;Password is :&quot;+encodedPassword);</stringProp>
            </JSR223PreProcessor>
