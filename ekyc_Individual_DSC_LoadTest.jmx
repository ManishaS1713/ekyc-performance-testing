      <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Photo1" enabled="true">
        <stringProp name="cacheKey">true</stringProp>
        <stringProp name="filename"></stringProp>
        <stringProp name="parameters"></stringProp>
        <stringProp name="script">// Path to the image file using double backslashes
String imagePath = &quot;D:\\apache-jmeter-5.5\\bin\\Photo1.jpg&quot;;

// Read the image file
File imageFile = new File(imagePath);

// Check if the file exists
if (imageFile.exists())
{
    FileInputStream fileInputStream = new FileInputStream(imageFile);
    byte[] imageData = new byte[(int) imageFile.length()];
    fileInputStream.read(imageData);
    fileInputStream.close();

    // Convert the image data to Base64
    String Photo1 = javax.xml.bind.DatatypeConverter.printBase64Binary(imageData);

    // Store the Base64 string in a variable
    vars.put(&quot;Photo1&quot;, Photo1);
}
else
{
    log.error(&quot;Image file not found at: &quot; + imageFile.getAbsolutePath());
}
</stringProp>
        <stringProp name="scriptLanguage">groovy</stringProp>
      </JSR223PreProcessor>
