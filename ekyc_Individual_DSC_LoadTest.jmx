        <stringProp name="script">// Path to the image file using double backslashes
String imagePath = &quot;D:\\apache-jmeter-5.5\\bin\\Photo2.jpg&quot;;

// Read the image file
File imageFile = new File(imagePath);

// Check if the file exists
if (imageFile.exists())
{
    FileInputStream fileInputStream = new FileInputStream(imageFile);
    byte[] imageData = new byte[(int) imageFile.length()];
    fileInputStream.read(imageData);
    fileInputStream.close();

    // Convert the image data to Base64
    String Photo2 = javax.xml.bind.DatatypeConverter.printBase64Binary(imageData);

    // Store the Base64 string in a variable
    vars.put(&quot;Photo2&quot;, Photo2);
}
else
{
    log.error(&quot;Image file not found at: &quot; + imageFile.getAbsolutePath());
}
</stringProp>
