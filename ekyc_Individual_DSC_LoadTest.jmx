              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="script">import org.apache.commons.io.FileUtils;

// Path to the file where responses will be saved
String filePath = &quot;C:/apache-jmeter-5.5/bin/Verasys_Error_Logs/Application_Organization_VerifyLater_EsignNow/23.2.24/30Users_10MIn_0SecDelay/Responses_Application_Organization_VerifyLater_EsignNow_Submit_002.txt&quot;;

// Get the response data
String responseData = prev.getResponseDataAsString();

// Append the response data to the file with a newline character
try
{
    FileUtils.writeStringToFile(new File(filePath), responseData + &quot;\n&quot;, true);
}
catch (IOException e)
{
    log.error(&quot;Error writing to file: &quot; + e.getMessage());
}
</stringProp>
